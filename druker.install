<?php

/**
 * @file
 * Install and update hooks for Druker.
 */

declare(strict_types=1);

use Drupal\druker\Entity\CronJob;

/**
 * Adds the runner field, so a job can say it is a shell command line.
 */
function druker_update_11001(): string {
  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('runner', 'druker_job', 'druker', CronJob::runnerFieldDefinition());

  return (string) t('Existing jobs keep running through Drush, which is the default.');
}

/**
 * Lets a job name more than one server.
 */
function druker_update_11002(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $storage_definition = $manager->getFieldStorageDefinition('server', 'druker_job');

  // A base field cannot change cardinality in place: single-value lives in a
  // column on the entity table, multi-value in a table of its own. So the
  // assignments are read out, the field is rebuilt, and they are written
  // back through the entity API.
  $assignments = \Drupal::database()->select('druker_job', 'j')
    ->fields('j', ['id', 'server'])
    ->isNotNull('server')
    ->execute()
    ->fetchAllKeyed();

  if ($storage_definition !== NULL) {
    $manager->uninstallFieldStorageDefinition($storage_definition);
  }

  $manager->installFieldStorageDefinition('server', 'druker_job', 'druker', CronJob::serverFieldDefinition());

  foreach ($assignments as $id => $server) {
    $job = CronJob::load($id);

    if ($job instanceof CronJob) {
      $job->set('server', [$server])->save();
    }
  }

  return (string) t('@count jobs kept the server they were assigned to.', ['@count' => count($assignments)]);
}

/**
 * Store the server enabled flag as a boolean, as the config schema says.
 */
function druker_update_11003(): string {
  $fixed = 0;

  foreach (\Drupal::configFactory()->listAll('druker.server.') as $name) {
    $config = \Drupal::configFactory()->getEditable($name);
    $status = $config->get('status');

    // Saving a server through the entity API normalizes this, so the stray
    // integers come from config written straight through the config factory
    // — a seed script, or a hand-edited YAML. Schema validation rejects it,
    // which breaks config import on a strict site.
    if (is_bool($status)) {
      continue;
    }

    $config->set('status', (bool) $status)->save();
    $fixed++;
  }

  return (string) t('@count servers had their enabled flag corrected.', ['@count' => $fixed]);
}
