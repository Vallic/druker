{
  "server": "web-01",
  "refresh": 600,
  "jobs": [
    {
      "id": 1,
      "name": "Process the mail queue",
      "command": "advancedqueue:queue:process mail",
      "runner": "drush",
      "async": true,
      "depends_on": null,
      "type": "cron",
      "cron": "* * * * *"
    },
    {
      "id": 2,
      "name": "Drupal cron",
      "command": "cron",
      "runner": "drush",
      "async": false,
      "depends_on": null,
      "type": "cron",
      "cron": "0 * * * *"
    },
    {
      "id": 3,
      "name": "Rebuild the search index",
      "command": "search-api:index",
      "runner": "drush",
      "async": true,
      "depends_on": 2,
      "type": "cron",
      "cron": "0 2 * * *"
    },
    {
      "id": 4,
      "name": "Weekly log summary",
      "command": "watchdog:show --count=100 --severity=Error",
      "runner": "drush",
      "async": true,
      "depends_on": null,
      "type": "cron",
      "cron": "0 0 * * 0"
    },
    {
      "id": 5,
      "name": "One-time content migration",
      "command": "migrate:import example_articles",
      "runner": "drush",
      "async": false,
      "depends_on": null,
      "type": "once",
      "run_at": 1747392000
    },
    {
      "id": 6,
      "name": "Rebuild caches once the migration is done",
      "command": "cache:rebuild",
      "runner": "drush",
      "async": false,
      "depends_on": 5,
      "type": "once",
      "run_at": 1747478400
    },
    {
      "id": 7,
      "name": "Nightly file backup",
      "command": "tar -czf /backups/files.tgz web/sites/default/files",
      "runner": "shell",
      "async": true,
      "depends_on": null,
      "type": "cron",
      "cron": "30 2 * * *"
    }
  ]
}
