{#
/**
 * @file
 * The day, hour by hour, so a pile-up at three in the morning is visible.
 */
#}
<div class="druker-day">
  <h3>{{ 'Across the day'|t }}</h3>

  <div class="druker-day__grid" style="--druker-hours: {{ hours|length }}">
    <div class="druker-day__label"></div>
    {% for hour in hours %}
      <div class="druker-day__hour">{{ hour }}</div>
    {% endfor %}

    {% for row in rows %}
      <div class="druker-day__label">
        <a href="{{ row.url }}">{{ row.label }}</a>
        {% if row.interval %}
          {# An hourly cron job fills the day too. The period is what says
             this one runs thousands of times rather than twenty-four. #}
          <span class="druker-day__every">{{ 'every @every s'|t({'@every': row.every}) }}</span>
        {% endif %}
      </div>
      {% for hour in hours %}
        <div class="druker-day__cell{{ hour in row.hours ? ' is-on' : '' }}{{ row.busy ? ' is-busy' : '' }}{{ row.interval ? ' is-interval' : '' }}"
             title="{{ row.label }}{% if row.interval %} — {{ 'every @every s, all day'|t({'@every': row.every}) }}{% elseif hour in row.hours %} — {{ hour }}:00{% endif %}"></div>
      {% endfor %}
    {% endfor %}
  </div>

  <p class="druker-day__note">{{ 'One-time jobs are not shown; they have a date rather than a shape. An interval job fills the day because it runs in every hour of it.'|t }}</p>
</div>
