<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="project">
  <description>Drupal coding standards, plus the practice sniffs.</description>

  <file>.</file>

  <arg name="extensions" value="php,module,inc,install,test,profile,theme,yml"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <exclude-pattern>./vendor/</exclude-pattern>
  <exclude-pattern>./node_modules/</exclude-pattern>
  <!-- The Go worker is not PHP, and phpcs should not walk into it. -->
  <exclude-pattern>./worker/</exclude-pattern>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
